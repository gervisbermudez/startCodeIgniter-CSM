{
  "name": "startcodeigneitercsm",
  "version": "3.0.0",
  "description": "Start CMS — admin SCSS (Vite) and Vue 2 islands for a CodeIgniter 3 content platform",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "copy-js": "bash bin/copy-js.sh",
    "build": "bash bin/copy-js.sh && vite build",
    "watch": "bash bin/watch.sh",
    "watch:css": "vite build --watch",
    "watch:js": "node bin/watch-js.mjs",
    "validate": "./bin/validate-env.sh",
    "backup-db": "./bin/backup-db.sh",
    "serve": "./bin/server.sh",
    "check": "./bin/check-diff.sh",
    "test": "node bin/qa-frontend-vue.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gervisbermudez/startCodeIgniter-CSM.git"
  },
  "author": "Gervis Bermúdez",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/gervisbermudez/startCodeIgniter-CSM/issues"
  },
  "homepage": "https://github.com/gervisbermudez/startCodeIgniter-CSM#readme",
  "devDependencies": {
    "glob": "^13.0.6",
    "sass": "^1.83.0",
    "terser": "^5.37.0",
    "vite": "^6.4.3"
  }
}
