APP_ENV=development
APP_BASE_URL=http://localhost:8081/

#DATABASE CONFIG
# host.docker.internal = MySQL del host (p. ej. contenedor tharsa-mysql)
DATABASE_HOSTNAME=host.docker.internal
DATABASE_DATABASE=start_cms_db
DATABASE_USER=ci_user
DATABASE_PASSWORD=ci_pass

# Cookie de sesión (CI). En un preview de worktree usá un nombre distinto
# (p. ej. ci_session_<slug>): las cookies de localhost no distinguen puerto
# y se pisarían con el admin de :8081.
# SESS_COOKIE_NAME=ci_session

# Google Analytics Tracking ID (optional)
GTAG=UA-XXXXXXXXX-X

# JWT Secret Key (CHANGE THIS IN PRODUCTION!)
JWT_SECRET_KEY=CHANGE_THIS_TO_A_RANDOM_STRING_IN_PRODUCTION
